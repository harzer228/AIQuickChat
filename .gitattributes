# Normalize text files to LF in the repository; check out Python/config
# sources as LF everywhere (CRLF checkouts change how linters like ruff
# treat some rules). Windows-only scripts keep CRLF.
* text=auto
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.spec text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.ico binary
*.png binary
*.exe binary
